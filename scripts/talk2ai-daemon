#!/bin/bash
# Supervisor + polling IA.
# El modo dictado lo gestiona talk2ai-handler (script externo de Handy).

HANDY_DB="${HANDY_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/com.pais.handy/history.db}"
_legacy_talk2ai_dir="$HOME/.talk2ai"
TALK2AI_DIR="${TALK2AI_DIR:-$(if [ -d "$_legacy_talk2ai_dir" ]; then printf '%s' "$_legacy_talk2ai_dir"; else printf '%s/talk2ai' "${XDG_STATE_HOME:-$HOME/.local/state}"; fi)}"
MODE_FILE="$TALK2AI_DIR/mode"
DRIVER_FILE="$TALK2AI_DIR/driver"
MODEL_FILE="$TALK2AI_DIR/model"
STATE_FILE="$TALK2AI_DIR/ai-state"
DEBUG_FILE="$TALK2AI_DIR/debug"
DEBUG_LOG="$TALK2AI_DIR/debug.log"
ERROR_LOG="$TALK2AI_DIR/errors.log"
VOICE_PROMPT="$TALK2AI_DIR/voice-prompt.md"
LAST_ID=0
LANGUAGE="es"
AI_MODEL="gemini-3.8-flash-low"

declare -A DRIVER_MODELS=(
    ["gemini"]="gemini-3.8-flash-low"
    ["ollama"]="qwen3.5:2b"
)

ERROR_MESSAGES=(
    "Vaya, algún bit se ha perdido y la respuesta no existe"
    "Ups, parece que los electrones se han ido de vacaciones"
    "Lo siento, el asistente se ha tomado un café y no ha vuelto"
    "Misteriosamente la respuesta ha desaparecido en el éter digital"
)

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

_speak() {
    local text="$1"
    local generation="${2:-}"
    local -a tts_args=(speak)
    [ -z "$generation" ] || tts_args+=(--generation "$generation")
    # The broker owns serialization, cancellation and engine fallback. Keep a
    # direct eSpeak fallback for installations upgraded before its service.
    if command -v talk2ai-tts >/dev/null 2>&1 && \
       printf '%s' "$text" | talk2ai-tts "${tts_args[@]}" >/dev/null 2>&1; then
        return 0
    fi
    # A generation-bound request can fail because Ctrl+Alt+Q won the race.
    # Never resurrect that cancelled turn through the legacy direct fallback.
    [ -z "$generation" ] || return 1
    local ssml
    ssml=$(printf '%s' "$text" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/Stephen Hawking/<lang xml:lang="en">Stephen Hawking<\/lang>/gi')
    espeak-ng -v "$LANGUAGE" -m -s 140 -p 40 "$ssml" 2>/dev/null
}

_cancel_generation() {
    cat "$TALK2AI_DIR/tts-cancel-generation" 2>/dev/null || printf '0\n'
}

_turn_cancelled() {
    [ "$(_cancel_generation)" != "$1" ]
}

_init_talk2ai() {
    mkdir -p "$TALK2AI_DIR/ia" "$TALK2AI_DIR/context"

    [ -f "$MODE_FILE" ]   || echo "ai"     > "$MODE_FILE"
    [ -f "$DRIVER_FILE" ] || echo "gemini" > "$DRIVER_FILE"

    # The installer deploys drivers and prompts to TALK2AI_DIR.  Do not read
    # an old checkout or another application's configuration at runtime.
    [ -f "$MODEL_FILE" ] || echo "$AI_MODEL" > "$MODEL_FILE"
    echo "idle"          > "$STATE_FILE"
}

_detect_session_type() {
    [ "$XDG_SESSION_TYPE" = "wayland" ] && echo "wayland" && return
    [ -n "$WAYLAND_DISPLAY" ]           && echo "wayland" && return
    [ -S "/run/user/$(id -u)/wayland-0" ] && echo "wayland" && return
    if [ -n "$XDG_SESSION_ID" ]; then
        _t=$(loginctl show-session "$XDG_SESSION_ID" -p Type --value 2>/dev/null)
        [ "$_t" = "wayland" ] && echo "wayland" && return
    fi
    _sid=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v uid="$(id -u)" '$2==uid {print $1; exit}')
    if [ -n "$_sid" ]; then
        _t=$(loginctl show-session "$_sid" -p Type --value 2>/dev/null)
        [ "$_t" = "wayland" ] && echo "wayland" && return
    fi
    echo "x11"
}

_run_driver() {
    local prompt="$1"
    local driver
    driver=$(cat "$DRIVER_FILE" 2>/dev/null || echo "gemini")
    local driver_script="$TALK2AI_DIR/ia/$driver"

    if [ ! -x "$driver_script" ]; then
        echo "Driver '$driver' no encontrado o no ejecutable" >&2
        return 1
    fi

    local context_file="$TALK2AI_DIR/context/$driver.md"
    local model_override_file="$TALK2AI_DIR/model-$driver"
    local model
    if [ -f "$model_override_file" ]; then
        model=$(cat "$model_override_file")
    else
        model="${DRIVER_MODELS[$driver]:-$AI_MODEL}"
    fi
    echo "$model" > "$MODEL_FILE"
    export TALK2AI_MODEL="$model"
    local driver_vp="$TALK2AI_DIR/voice-prompt-$driver.md"
    if [ -f "$driver_vp" ]; then
        export TALK2AI_VOICE_PROMPT="$driver_vp"
    else
        export TALK2AI_VOICE_PROMPT="$VOICE_PROMPT"
    fi
    export TALK2AI_CONTEXT_FILE=""
    [ -f "$context_file" ] && export TALK2AI_CONTEXT_FILE="$context_file"
    local ollama_host_file="$TALK2AI_DIR/ollama-host"
    if [ -f "$ollama_host_file" ]; then
        export TALK2AI_OLLAMA_HOST=$(cat "$ollama_host_file")
    else
        export TALK2AI_OLLAMA_HOST="${TALK2AI_OLLAMA_HOST:-http://127.0.0.1:11434}"
    fi

    # Isolate every turn in its own process group.  The parent polls the
    # stream, so cancellation is observed even when the driver emits nothing.
    setsid "$driver_script" "$prompt" 2>"$_err_tmp" &
    local driver_pid=$!
    printf '%s\n' "$driver_pid" > "$_driver_pid_file"
    wait "$driver_pid"
}

_stop_turn_driver() {
    local driver_pid monitor_pid pid_file="$1"
    monitor_pid="$2"
    local stopped_file="${pid_file}.stopped"
    # A turn has one owner for its process group.  This marker makes cleanup
    # idempotent and prevents a repeated cancel from signalling a reused PID.
    [ -e "$stopped_file" ] && return 0
    : > "$stopped_file"
    driver_pid=$(cat "$pid_file" 2>/dev/null || true)
    if [[ "$driver_pid" =~ ^[0-9]+$ ]]; then
        kill -TERM -- "-$driver_pid" 2>/dev/null || true
        kill -TERM "$driver_pid" 2>/dev/null || true
    fi
    kill -TERM "$monitor_pid" 2>/dev/null || true
    for _ in {1..20}; do
        local alive=false
        if [[ "$driver_pid" =~ ^[0-9]+$ ]] && kill -0 "$driver_pid" 2>/dev/null; then alive=true; fi
        if kill -0 "$monitor_pid" 2>/dev/null; then alive=true; fi
        [[ "$alive" = false ]] && break
        sleep 0.1
    done
    if [[ "$driver_pid" =~ ^[0-9]+$ ]] && kill -0 "$driver_pid" 2>/dev/null; then
        kill -KILL -- "-$driver_pid" 2>/dev/null || true
        kill -KILL "$driver_pid" 2>/dev/null || true
    fi
    kill -KILL "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
}

# Read characters incrementally while buffering each kernel read. Bash read
# returns >128 on timeout and 1 on EOF; both can carry partial data.
_read_driver_char() {
    _driver_char=""
    if [ -n "${_driver_pending:-}" ]; then
        _driver_char="${_driver_pending:0:1}"
        _driver_pending="${_driver_pending:1}"
        return 0
    fi
    if [ "${_driver_pending_eof:-false}" = true ]; then
        return 1
    fi
    local chunk
    chunk=""
    IFS= read -r -t 0.2 -N 1024 chunk <&"$_driver_fd"
    status=$?
    _driver_pending="$chunk"
    [ "$status" -eq 1 ] && _driver_pending_eof=true
    if [ -n "$_driver_pending" ]; then
        _driver_char="${_driver_pending:0:1}"
        _driver_pending="${_driver_pending:1}"
        return 0
    elif [ "$status" -eq 0 ]; then
        return 2
    elif [ "$status" -gt 128 ]; then
        return 2  # timeout with no buffered character
    elif [ "$status" -eq 1 ]; then
        return 1  # EOF with no buffered character
    fi
    return 3      # an actual read error
}

_normalize_tts_text() {
    # The original response is kept separately; this is only for speech.
    printf '%s' "$1" | tr '\n' ' ' |
        sed 's/\[ENLACE:[^]]*\]//g; s/[[:space:]][[:space:]]*/ /g; s/^ //;s/ $//'
}

_cleanup_turn_driver() {
    local temporary_dir="$1"
    [ -n "$temporary_dir" ] && [ -d "$temporary_dir" ] || return 0
    [ -f "$temporary_dir/.talk2ai-turn" ] || return 0
    rm -rf -- "$temporary_dir"
}

main() {
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
    echo -e "${GREEN}   talk2ai daemon${NC}"
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
    echo ""
    echo "🤖 Alt+Super+G  → Modo IA       (polling SQLite)"
    echo "⌨️  Alt+Super+H  → Modo Dictado  (script externo Handy)"
    echo "🎙️  Ctrl+Space   → Grabar (PTT)"
    echo "⏸️  Ctrl+Alt+Q   → Detener audio"
    echo ""

    _init_talk2ai

    SESSION_TYPE=$(_detect_session_type)
    if [ "$SESSION_TYPE" = "wayland" ]; then
        if ! pgrep -f "(^|/)talk2ai-keys( |$)" >/dev/null 2>&1; then
            talk2ai-keys &
            echo "talk2ai-keys lanzado en Wayland"
        else
            echo "talk2ai-keys ya estaba activo"
        fi
    else
        export DISPLAY="${DISPLAY:-:0}"
        XAUTH_FILE=$(ls /run/user/$(id -u)/xauth_* 2>/dev/null | head -1)
        [ -n "$XAUTH_FILE" ] && export XAUTHORITY="$XAUTH_FILE"
        if ! pgrep -x xbindkeys >/dev/null 2>&1; then
            xbindkeys &
            echo "xbindkeys lanzado en X11"
        else
            echo "xbindkeys ya estaba activo"
        fi
    fi

    if [ ! -f "$HANDY_DB" ]; then
        echo -e "${RED}❌ BD no encontrada: $HANDY_DB${NC}"
        return 1
    fi

    LAST_ID=$(sqlite3 "$HANDY_DB" "SELECT COALESCE(MAX(id), 0) FROM transcription_history" 2>/dev/null || echo "0")
    LOOP_COUNT=0
    USE_WAYLAND=false
    [ "$SESSION_TYPE" = "wayland" ] && USE_WAYLAND=true

    while true; do
        sleep 1

        # Keepalive talk2ai-keys cada 10s
        if $USE_WAYLAND && [ $((LOOP_COUNT % 10)) -eq 0 ]; then
            if ! pgrep -f "python3.*talk2ai-keys" > /dev/null 2>&1; then
                echo "⚠ talk2ai-keys caído, relanzando..."
                talk2ai-keys &
            fi
        fi
        LOOP_COUNT=$((LOOP_COUNT + 1))

        result=$(sqlite3 "$HANDY_DB" "SELECT id, transcription_text FROM transcription_history WHERE id > $LAST_ID ORDER BY id DESC LIMIT 1" 2>/dev/null)
        [ -z "$result" ] && continue

        NEW_ID=$(echo "$result" | cut -d'|' -f1)
        TRANSCRIPTION=$(echo "$result" | cut -d'|' -f2-)
        [ -z "$NEW_ID" ] || [ "$NEW_ID" -le "$LAST_ID" ] && continue
        LAST_ID=$NEW_ID

        # Modo dictado: lo gestiona el script externo de Handy, no el daemon
        MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "ai")
        [ "$MODE" = "dictate" ] && continue

        [ -z "${TRANSCRIPTION// }" ] && continue

        echo ""
        echo -e "${YELLOW}🎤 Dijiste: $TRANSCRIPTION${NC}"

        _T_START=$(date +%s%3N)
        if [ -f "$DEBUG_FILE" ]; then
            _dbg_driver=$(cat "$DRIVER_FILE" 2>/dev/null || echo "gemini")
            _dbg_model_file="$TALK2AI_DIR/model-$_dbg_driver"
            if [ -f "$_dbg_model_file" ]; then
                _dbg_model=$(cat "$_dbg_model_file")
            else
                _dbg_model="${DRIVER_MODELS[$_dbg_driver]:-$AI_MODEL}"
            fi
            {
                echo "$_T_START|SEP|"
                echo "$_T_START|INFO|Modelo: $_dbg_model  ·  Driver: $_dbg_driver"
                echo "$_T_START|Q|$TRANSCRIPTION"
            } >> "$DEBUG_LOG"
        fi

        _driver_tmp_dir=$(mktemp -d)
        chmod 700 "$_driver_tmp_dir"
        : > "$_driver_tmp_dir/.talk2ai-turn"
        _err_tmp="$_driver_tmp_dir/driver.stderr"
        _driver_fifo="$_driver_tmp_dir/driver.fifo"
        _driver_pid_file="$_driver_tmp_dir/driver.pid"
        echo "processing" > "$STATE_FILE"
        buffer=""
        response=""
        _driver_pending=""
        _driver_pending_eof=false
        _phrases=()
        _first_speak=true
        _turn_generation=$(_cancel_generation)
        _turn_cancelled=false
        _driver_exit_seen=false
        _driver_exit_deadline=0

        mkfifo "$_driver_fifo"
        _run_driver "$TRANSCRIPTION" >"$_driver_fifo" &
        _driver_monitor_pid=$!
        exec {_driver_fd}<"$_driver_fifo"
        rm -f "$_driver_fifo"
        while :; do
            if _turn_cancelled "$_turn_generation"; then
                _turn_cancelled=true
                _stop_turn_driver "$_driver_pid_file" "$_driver_monitor_pid"
                break
            fi
            _read_driver_char
            _read_status=$?
            if [ -n "$_driver_char" ]; then
                # Preserve the original response exactly. Newlines are
                # normalized only when a fragment is sent to TTS.
                buffer+="$_driver_char"
                response+="$_driver_char"
            fi
            if [ "$_read_status" -eq 2 ]; then
                # Supervisor exit is not EOF: descendants may still hold the
                # FIFO open and bytes may remain buffered. Bound that case.
                if ! kill -0 "$_driver_monitor_pid" 2>/dev/null; then
                    if [ "$_driver_exit_seen" = false ]; then
                        _driver_exit_seen=true
                        _driver_exit_deadline=$(( $(date +%s%3N) + 1000 ))
                    elif [ "$(date +%s%3N)" -ge "$_driver_exit_deadline" ]; then
                        _turn_cancelled=true
                        _stop_turn_driver "$_driver_pid_file" "$_driver_monitor_pid"
                        break
                    fi
                fi
                continue
            elif [ "$_read_status" -eq 1 ]; then
                break
            elif [ "$_read_status" -ne 0 ]; then
                _turn_cancelled=true
                _stop_turn_driver "$_driver_pid_file" "$_driver_monitor_pid"
                break
            fi
            if [[ "$buffer" =~ [.!?:][[:space:]]*$ ]] || [ ${#buffer} -ge 150 ]; then
                if [ -f "$DEBUG_FILE" ]; then
                    _phrases+=("${buffer## }")
                fi
                if $_first_speak; then _first_speak=false; fi
                _spoken_now=$(_normalize_tts_text "$buffer")
                if [ -n "$_spoken_now" ] && ! _speak "$_spoken_now" "$_turn_generation"; then
                    _turn_cancelled=true
                    _stop_turn_driver "$_driver_pid_file" "$_driver_monitor_pid"
                    break
                fi
                buffer=""
            fi
        done
        exec {_driver_fd}<&-
        if [[ "$_turn_cancelled" = true ]]; then
            _stop_turn_driver "$_driver_pid_file" "$_driver_monitor_pid"
        else
            wait "$_driver_monitor_pid" 2>/dev/null || true
        fi
        rm -f "$_driver_pid_file"

        if [ "$_turn_cancelled" = false ] && [ -n "${buffer## }" ] && ! _turn_cancelled "$_turn_generation"; then
            _phrases+=("${buffer## }")
            _spoken_tail=$(_normalize_tts_text "$buffer")
            [ -z "$_spoken_tail" ] || _speak "$_spoken_tail" "$_turn_generation" || _turn_cancelled=true
        fi
        _stderr=$(cat "$_err_tmp"); rm -f "$_err_tmp"
        _cleanup_turn_driver "$_driver_tmp_dir"

        # Extraer enlaces [ENLACE: url] del response antes de hablar
        _links=()
        while IFS= read -r _link; do
            [ -n "$_link" ] && _links+=("$_link")
        done < <(printf '%s' "$response" | grep -oP '(?<=\[ENLACE:\s)([^\]]+)(?=\])' 2>/dev/null || \
                 printf '%s' "$response" | grep -o '\[ENLACE:[^]]*\]' | sed 's/\[ENLACE: *//;s/\]//')
        _response_spoken=$(_normalize_tts_text "$response")

        if [ "$_turn_cancelled" = false ] && [ -n "$response" ]; then
            printf '%b✅ %s%b\n' "$GREEN" "$response" "$NC"
            if [ -f "$DEBUG_FILE" ]; then
                _T_END=$(date +%s%3N)
                {
                    echo "$_T_END|A|$response"
                    for _l in "${_links[@]}"; do
                        echo "$_T_END|L|$_l"
                    done
                } >> "$DEBUG_LOG"
            fi
            for _l in "${_links[@]}"; do
                # Notificación con botón Abrir — se gestiona en subshell desacoplado
                (
                    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
                    export DISPLAY="${DISPLAY:-:0}"
                    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
                    _clicked=$(notify-send "🔗 Enlace" "$_l" --action="open:Abrir" --wait -t 15000 2>/dev/null)
                    [ -n "$_clicked" ] && xdg-open "$_l" 2>/dev/null
                ) </dev/null >/dev/null 2>/dev/null &
                disown
            done
            # Hablar solo el texto sin URLs
            _phrases_spoken=()
            for _p in "${_phrases[@]}"; do
                _ps=$(_normalize_tts_text "$_p")
                [ -n "$_ps" ] && _phrases_spoken+=("$_ps")
            done
            # Fragments were queued in FIFO order while the driver streamed;
            # they must not be synthesized a second time here.
        fi

        echo "idle" > "$STATE_FILE"

        if [ "$_turn_cancelled" = false ] && [ -z "$response" ]; then
            _rand_msg="${ERROR_MESSAGES[$((RANDOM % ${#ERROR_MESSAGES[@]}))]}"
            echo -e "${RED}❌ Sin respuesta del driver${NC}"
            [ -n "$_stderr" ] && echo -e "${RED}   stderr: $_stderr${NC}"
            {
                echo "[$(date '+%Y-%m-%d %H:%M:%S')]"
                echo "  Transcripción: $TRANSCRIPTION"
                [ -n "$_stderr" ] && echo "  stderr: $_stderr"
                echo "---"
            } >> "$ERROR_LOG"
            _speak "$_rand_msg" "$_turn_generation" || true
        fi
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
