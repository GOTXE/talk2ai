#!/usr/bin/env python3
"""Closed-catalog TTS broker for talk2ai.

Text is always data: clients submit UTF-8 on stdin to a Unix socket.  The
single broker owns the FIFO and child process groups, so replies streamed by an
AI driver cannot overlap and one cancel operation covers every engine.
"""
from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import queue
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
from pathlib import Path

MAX_TEXT = 12000
# Requests and replies are newline-delimited JSON.  Keep the protocol bounded
# so a peer cannot make the broker retain an unbounded partial message.
MAX_MESSAGE = MAX_TEXT + 2048
TEST_PHRASE = "Hola. Esta es una prueba de voz de talk2ai."
_legacy_root = Path.home() / ".talk2ai"
_xdg_state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "talk2ai"
ROOT = Path(os.environ.get("TALK2AI_DIR") or (_legacy_root if _legacy_root.exists() else _xdg_state))
_xdg_runtime = os.environ.get("XDG_RUNTIME_DIR")
# A user service normally supplies XDG_RUNTIME_DIR.  A private state fallback
# keeps command-line use portable on systems that do not.
RUNTIME = Path(_xdg_runtime) if _xdg_runtime else ROOT / "runtime"
SOCKET = RUNTIME / "talk2ai-tts.sock"
DATA_ROOT = Path(os.environ.get(
    "TALK2AI_DATA_DIR",
    Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "talk2ai",
))
CATALOG = DATA_ROOT / "tts-catalog.json"
ARTIFACTS = DATA_ROOT / "tts-artifacts.json"


def atomic_write(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as output:
        output.write(value)
        temp = Path(output.name)
    os.replace(temp, path)


def bootstrap() -> None:
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(ROOT, 0o700)
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(RUNTIME, 0o700)
    (ROOT / "tts" / "tmp").mkdir(mode=0o700, parents=True, exist_ok=True)
    DATA_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(DATA_ROOT, 0o700)
    # install.sh always puts versioned catalog data in DATA_ROOT.  Retaining a
    # source-tree fallback keeps direct checkout execution useful for tests;
    # an installed script in ~/.local/bin never depends on a cloned repo.
    source_config = Path(__file__).resolve().parent.parent / "config"
    for name, destination in (("tts-catalog.json", CATALOG),
                              ("tts-artifacts.json", ARTIFACTS)):
        source = source_config / name
        if not destination.exists() and source.is_file():
            shutil.copyfile(source, destination)
        if not destination.is_file():
            raise RuntimeError(f"falta {name}; reinstala talk2ai para desplegar sus datos")
    # Existing installations only gain independent defaults; AI state is not touched.
    if not (ROOT / "tts-engine").exists():
        atomic_write(ROOT / "tts-engine", "espeak-ng\n")
    if not (ROOT / "tts-voice").exists():
        atomic_write(ROOT / "tts-voice", "es\n")
    if not (ROOT / "tts-speed").exists():
        atomic_write(ROOT / "tts-speed", "140\n")


def load_json(path: Path) -> dict:
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def profiles() -> list[dict]:
    return load_json(CATALOG)["profiles"]


def profile_by_id(profile_id: str) -> dict | None:
    return next((item for item in profiles() if item["id"] == profile_id), None)


def read_pref(name: str, default: str) -> str:
    try:
        return (ROOT / name).read_text(encoding="utf-8").strip() or default
    except OSError:
        return default


def current_profile() -> dict:
    engine = read_pref("tts-engine", "espeak-ng")
    voice = read_pref("tts-voice", "es")
    profile = next((item for item in profiles() if item["engine"] == engine and item["voice"] == voice), None)
    return profile or profile_by_id("espeak-retro")  # type: ignore[return-value]


def kokoro_ready() -> tuple[bool, str]:
    base = ROOT / "tts" / "kokoro"
    runtime = ROOT / "tts-venv" / "bin" / "python"
    if not (base / "kokoro-v1.0.int8.onnx").is_file() or not (base / "voices-v1.0.bin").is_file():
        return False, "modelo y voces no instalados (descarga explícita requerida)"
    if not runtime.is_file():
        return False, "runtime aislado no instalado"
    # A file named python is not a runtime.  Probe the isolated interpreter
    # without loading a model, so selection never advertises a broken venv.
    try:
        probe = subprocess.run(
            [str(runtime), "-c", "import kokoro_onnx, misaki"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False, "runtime Kokoro no se puede ejecutar"
    if probe.returncode:
        return False, "runtime Kokoro incompleto (requiere kokoro-onnx y misaki)"
    return False, "Kokoro pendiente de una prueba real de voces españolas"


def availability(profile: dict) -> tuple[bool, str]:
    status = profile["status"]
    if status == "blocked":
        return False, profile["reason"]
    if profile["engine"] == "espeak-ng":
        return shutil.which("espeak-ng") is not None, "espeak-ng no está instalado"
    if profile["engine"] == "kokoro-onnx":
        return kokoro_ready()
    return False, "motor no aprobado"


def report_profiles() -> list[dict]:
    result = []
    for profile in profiles():
        enabled, reason = availability(profile)
        result.append({**profile, "available": enabled, "availability_reason": reason if not enabled else "instalado"})
    return result


def safe_text(text: str) -> str:
    if "\0" in text or len(text) > MAX_TEXT:
        raise ValueError("texto TTS inválido")
    return text.strip()


def engine_speed(profile: dict, value: str) -> int | float:
    """Validate a persisted speed in the units used by this engine.

    eSpeak words-per-minute and Kokoro's multiplier are intentionally never
    interchangeable.  Old preferences are tolerated by falling back to the
    profile default rather than passing a nonsense value to an engine.
    """
    engine = profile["engine"]
    default = profile["default_speed"]
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        parsed = float(default)
    if engine == "espeak-ng":
        if not 80 <= parsed <= 450 or not parsed.is_integer():
            return int(default)
        return int(parsed)
    if engine == "kokoro-onnx":
        if not 0.5 <= parsed <= 2.0:
            return float(default)
        return round(parsed, 2)
    return default


class Broker:
    def __init__(self) -> None:
        self.requests: queue.Queue[tuple[str, dict, int]] = queue.Queue()
        self.stop = threading.Event()
        self.lock = threading.Lock()
        self.active: subprocess.Popen | None = None
        self.kokoro: subprocess.Popen | None = None
        self.playing = False
        try:
            previous_generation = int((ROOT / "tts-cancel-generation").read_text().strip())
        except (OSError, ValueError):
            previous_generation = 0
        # A broker instance is a new trust boundary.  Advance the durable
        # epoch before accepting requests so fragments from a previous
        # process can never be replayed after a restart.
        self.generation = previous_generation + 1
        atomic_write(ROOT / "tts-cancel-generation", f"{self.generation}\n")
        self.thread = threading.Thread(target=self.playback, daemon=True)

    def start(self) -> None:
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            if SOCKET.exists():
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                    probe.settimeout(0.2)
                    try:
                        probe.connect(str(SOCKET))
                    except (ConnectionRefusedError, FileNotFoundError):
                        SOCKET.unlink()
                    except OSError as exc:
                        raise RuntimeError("ya existe una instancia activa del broker TTS") from exc
                    else:
                        raise RuntimeError("ya existe una instancia activa del broker TTS")
            server.bind(str(SOCKET))
        except Exception:
            server.close()
            raise
        os.chmod(SOCKET, 0o600)
        server.listen(16)
        self.thread.start()
        try:
            while not self.stop.is_set():
                try:
                    connection, _ = server.accept()
                except OSError:
                    break
                threading.Thread(target=self.handle, args=(connection,), daemon=True).start()
        finally:
            server.close()
            SOCKET.unlink(missing_ok=True)

    def handle(self, connection: socket.socket) -> None:
        with connection:
            try:
                if hasattr(socket, "SO_PEERCRED"):
                    credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
                    peer_uid = int.from_bytes(credentials[4:8], sys.byteorder)
                    if peer_uid != os.getuid():
                        raise PermissionError("cliente de otro usuario rechazado")
                stream = connection.makefile("rb")
                raw = stream.readline(MAX_MESSAGE + 1)
                if not raw.endswith(b"\n"):
                    raise ValueError("mensaje TTS sin delimitador o demasiado grande")
                if len(raw) > MAX_MESSAGE:
                    raise ValueError("mensaje TTS demasiado grande")
                payload = raw.decode("utf-8")
                request = json.loads(payload)
                command = request.get("command")
                if command == "speak":
                    supplied_generation = request.get("generation")
                    requested = request.get("profile")
                    profile = profile_by_id(requested) if requested else current_profile()
                    if not profile:
                        raise ValueError("perfil TTS desconocido")
                    self.enqueue(request.get("text", ""), profile, supplied_generation)
                    result = {"ok": True, "status": "queued"}
                elif command == "cancel":
                    self.cancel()
                    result = {"ok": True, "status": "cancelled"}
                elif command == "status":
                    result = {"ok": True, "queue": self.requests.qsize(), "profile": current_profile()["id"]}
                else:
                    result = {"ok": False, "error": "comando no permitido"}
            except Exception as exc:
                result = {"ok": False, "error": str(exc)}
            connection.sendall((json.dumps(result, ensure_ascii=False) + "\n").encode("utf-8"))

    def cancel(self) -> None:
        with self.lock:
            self.generation += 1
            while True:
                try:
                    self.requests.get_nowait()
                except queue.Empty:
                    break
            for process in (self.active, self.kokoro):
                if process and process.poll() is None:
                    try:
                        os.killpg(process.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    threading.Thread(target=self._kill_if_needed, args=(process,), daemon=True).start()
            self.active = None
            self.kokoro = None
            self.playing = False
            # Persist while holding the same lock used by enqueue.  A daemon
            # cannot observe a new epoch before it is safe to submit it.
            atomic_write(ROOT / "tts-cancel-generation", str(self.generation) + "\n")
            atomic_write(ROOT / "tts-state", "cancelled\n")

    def enqueue(self, text: str, profile: dict, supplied_generation: int | None = None) -> int:
        """Validate, stamp and enqueue one request as one critical section."""
        text = safe_text(text)
        with self.lock:
            generation = self.generation
            if supplied_generation is not None and supplied_generation != generation:
                raise RuntimeError("turno TTS cancelado")
            self.requests.put((text, profile, generation))
            # Do not hide active synthesis/playback behind a newly queued
            # fragment.  The worker owns the speaking -> queued/idle
            # transition once the current item finishes.
            if not self.playing and not self._process_running(self.active) and not self._process_running(self.kokoro):
                atomic_write(ROOT / "tts-state", "queued\n")
            return generation

    @staticmethod
    def _process_running(process: subprocess.Popen | None) -> bool:
        return process is not None and process.poll() is None

    @staticmethod
    def _kill_if_needed(process: subprocess.Popen) -> None:
        """Bound cancellation: TERM first, then KILL for stuck engines."""
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def playback(self) -> None:
        while not self.stop.is_set():
            text, profile, generation = self.requests.get()
            if not text:
                continue
            with self.lock:
                if generation != self.generation:
                    continue
                self.playing = True
                atomic_write(ROOT / "tts-state", "speaking\n")
            try:
                self.speak(text, profile, generation)
            except Exception as exc:
                self.write_if_current(generation, ROOT / "tts-error", str(exc) + "\n")
                # A non-default engine must never make speech unavailable.
                if profile["engine"] != "espeak-ng" and self.is_current(generation):
                    try:
                        self.speak(text, profile_by_id("espeak-retro"), generation)  # type: ignore[arg-type]
                    except Exception as fallback:
                        self.write_if_current(generation, ROOT / "tts-error", f"{exc}; fallback: {fallback}\n")
            with self.lock:
                if self.playing and generation == self.generation:
                    self.playing = False
                    # Decide and publish under one lock so enqueue cannot
                    # invalidate the state between those two operations.
                    next_state = "queued" if not self.requests.empty() else "idle"
                    atomic_write(ROOT / "tts-state", next_state + "\n")

    def set_state_if_current(self, generation: int, state: str) -> bool:
        """Publish a state only while its generation still owns the turn."""
        with self.lock:
            if generation != self.generation:
                return False
            atomic_write(ROOT / "tts-state", state + "\n")
            return True

    def write_if_current(self, generation: int, path: Path, value: str) -> bool:
        with self.lock:
            if generation != self.generation:
                return False
            atomic_write(path, value)
            return True

    def is_current(self, generation: int) -> bool:
        with self.lock:
            return generation == self.generation

    def invoke(self, command: list[str], generation: int) -> None:
        with self.lock:
            if generation != self.generation:
                raise RuntimeError("reproducción cancelada")
            process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL, start_new_session=True)
            self.active = process
        result = process.wait()
        with self.lock:
            if self.active is process:
                self.active = None
        if result:
            raise RuntimeError(f"reproductor terminó con código {result}")

    def speak(self, text: str, profile: dict, generation: int) -> None:
        if not self.is_current(generation):
            raise RuntimeError("síntesis cancelada")
        available, reason = availability(profile)
        if not available:
            raise RuntimeError(reason)
        if profile["engine"] == "espeak-ng":
            # Preserve the established Spanish Retro synthesis parameters.
            speed = engine_speed(profile, read_pref("tts-speed", "140"))
            # Keep the historical Stephen Hawking language hint, but never let
            # streamed AI text become arbitrary SSML.
            safe_ssml = html.escape(text).replace(
                "Stephen Hawking", '<lang xml:lang="en">Stephen Hawking</lang>')
            self.invoke(["espeak-ng", "-v", "es", "-m", "-s", str(speed), "-p", "40", safe_ssml], generation)
            return
        wav = self.kokoro_wav(text, profile, generation)
        try:
            player = shutil.which("aplay")
            if not player:
                raise RuntimeError("aplay no está instalado")
            self.invoke([player, "-q", wav], generation)
        finally:
            Path(wav).unlink(missing_ok=True)

    def kokoro_wav(self, text: str, profile: dict, generation: int) -> str:
        with self.lock:
            if not self.kokoro or self.kokoro.poll() is not None:
                worker = Path(__file__).with_name("talk2ai-tts-kokoro")
                runtime = ROOT / "tts-venv" / "bin" / "python"
                env = {**os.environ, "TALK2AI_TTS_DIR": str(ROOT)}
                self.kokoro = subprocess.Popen([str(runtime), str(worker)], stdin=subprocess.PIPE,
                                                stdout=subprocess.PIPE, text=True, bufsize=1,
                                                start_new_session=True, env=env)
            worker = self.kokoro
            assert worker.stdin and worker.stdout
            worker.stdin.write(json.dumps({"text": text, "voice": profile["voice"],
                                           "speed": engine_speed(profile, read_pref("tts-speed", "1.0"))}) + "\n")
            worker.stdin.flush()
        line = worker.stdout.readline()
        if not self.is_current(generation):
            raise RuntimeError("síntesis cancelada")
        reply = json.loads(line or "{}")
        if not reply.get("ok"):
            raise RuntimeError(reply.get("error", "Kokoro no respondió"))
        path = reply["path"]
        if not self.is_current(generation):
            Path(path).unlink(missing_ok=True)
            raise RuntimeError("síntesis cancelada")
        return path


def send(request: dict) -> dict:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(2)
            client.connect(str(SOCKET))
            client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
            reply = client.makefile("rb").readline(MAX_MESSAGE + 1)
            if not reply.endswith(b"\n") or len(reply) > MAX_MESSAGE:
                raise RuntimeError("respuesta TTS inválida")
            result = json.loads(reply.decode("utf-8"))
            if not result.get("ok"):
                raise RuntimeError(result.get("error", "el broker rechazó la solicitud"))
            return result
    except OSError as exc:
        raise RuntimeError("el servicio TTS no está activo") from exc


def verified_download(item: dict, destination: Path) -> None:
    expected = item["sha256"].lower()
    if destination.exists():
        digest = hashlib.sha256(destination.read_bytes()).hexdigest()
        if digest == expected:
            return
        raise RuntimeError(f"{destination.name} existe y no coincide con el SHA-256 esperado")
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".download-", dir=destination.parent)
    try:
        digest = hashlib.sha256()
        with os.fdopen(fd, "wb") as output, urllib.request.urlopen(item["url"], timeout=60) as response:
            while chunk := response.read(1024 * 1024):
                digest.update(chunk)
                output.write(chunk)
        if digest.hexdigest() != expected:
            raise RuntimeError(f"SHA-256 inválido para {item['name']}")
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)
    except Exception:
        Path(temporary).unlink(missing_ok=True)
        raise


def download_kokoro(confirm: bool) -> None:
    if not confirm:
        raise RuntimeError("la descarga es opcional: repita con --confirm")
    manifest = load_json(ARTIFACTS)["kokoro"]
    base = ROOT / "tts" / "kokoro"
    for key in ("model", "voices"):
        item = manifest[key]
        verified_download(item, base / item["name"])
    print("Kokoro-82M y el paquete de voces se han descargado y verificado. Instale antes el runtime aislado auditado.")


def choose(profile_id: str) -> None:
    profile = profile_by_id(profile_id)
    if not profile:
        raise RuntimeError("perfil desconocido")
    available, reason = availability(profile)
    if not available:
        raise RuntimeError(f"perfil no seleccionable: {reason}")
    atomic_write(ROOT / "tts-engine", profile["engine"] + "\n")
    atomic_write(ROOT / "tts-voice", profile["voice"] + "\n")
    atomic_write(ROOT / "tts-speed", str(profile["default_speed"]) + "\n")


def set_speed(value: float) -> None:
    profile = current_profile()
    normalized = engine_speed(profile, str(value))
    if float(normalized) != value:
        unit = "ppm" if profile["engine"] == "espeak-ng" else "multiplicador"
        raise RuntimeError(f"velocidad fuera de rango para {profile['engine']} ({unit})")
    atomic_write(ROOT / "tts-speed", str(normalized) + "\n")


def main() -> int:
    parser = argparse.ArgumentParser(description="talk2ai TTS closed-catalog broker")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("serve")
    listing = sub.add_parser("list")
    listing.add_argument("--json", action="store_true")
    select = sub.add_parser("select")
    select.add_argument("profile")
    speed = sub.add_parser("speed")
    speed.add_argument("value", type=float)
    sub.add_parser("speak")
    # Daemons streaming a response attach the cancellation epoch they observed
    # at the start of the turn.  Standalone clients intentionally omit it.
    parser_speak = sub.choices["speak"]
    parser_speak.add_argument("--generation", type=int)
    test = sub.add_parser("test")
    test.add_argument("profile")
    download = sub.add_parser("download")
    download.add_argument("profile", choices=["kokoro-ef-dora", "kokoro-em-alex", "kokoro-em-santa"])
    download.add_argument("--confirm", action="store_true")
    sub.add_parser("cancel")
    sub.add_parser("status")
    args = parser.parse_args()
    bootstrap()
    try:
        if args.command == "serve":
            Broker().start()
        elif args.command == "list":
            data = report_profiles()
            if args.json:
                print(json.dumps(data, ensure_ascii=False))
            else:
                for item in data:
                    print(f"{item['id']}\t{'available' if item['available'] else 'unavailable'}\t{item['availability_reason']}")
        elif args.command == "select":
            choose(args.profile)
        elif args.command == "speed":
            set_speed(args.value)
        elif args.command == "download":
            download_kokoro(args.confirm)
        elif args.command == "speak":
            request = {"command": "speak", "text": sys.stdin.read()}
            if args.generation is not None:
                request["generation"] = args.generation
            print(json.dumps(send(request), ensure_ascii=False))
        elif args.command == "test":
            profile = profile_by_id(args.profile)
            if not profile:
                raise RuntimeError("perfil desconocido")
            available, reason = availability(profile)
            if not available:
                raise RuntimeError(f"perfil no disponible: {reason}")
            # A test never changes the persistent selection.
            print(json.dumps(send({"command": "speak", "text": TEST_PHRASE,
                                   "profile": profile["id"]}), ensure_ascii=False))
        elif args.command in {"cancel", "status"}:
            print(json.dumps(send({"command": args.command}), ensure_ascii=False))
    except Exception as exc:
        print(f"talk2ai-tts: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
