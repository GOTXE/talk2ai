#!/usr/bin/env python3
"""Closed-catalog TTS broker for talk2ai.

Text is always data: clients submit UTF-8 on stdin to a Unix socket.  The
single broker owns the FIFO and child process groups, so replies streamed by an
AI driver cannot overlap and one cancel operation covers every engine.
"""
from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import queue
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
from pathlib import Path

MAX_TEXT = 12000
TEST_PHRASE = "Hola. Esta es una prueba de voz de talk2ai."
ROOT = Path(os.environ.get("TALK2AI_DIR", Path.home() / ".talk2ai"))
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
SOCKET = RUNTIME / "talk2ai-tts.sock"
REPO = Path(__file__).resolve().parent.parent
CATALOG = ROOT / "tts-catalog.json"
ARTIFACTS = ROOT / "tts-artifacts.json"


def atomic_write(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as output:
        output.write(value)
        temp = Path(output.name)
    os.replace(temp, path)


def bootstrap() -> None:
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    (ROOT / "tts" / "tmp").mkdir(mode=0o700, parents=True, exist_ok=True)
    for source, destination in ((REPO / "config" / "tts-catalog.json", CATALOG),
                                (REPO / "config" / "tts-artifacts.json", ARTIFACTS)):
        if not destination.exists() and source.exists():
            shutil.copyfile(source, destination)
    # Existing installations only gain independent defaults; AI state is not touched.
    if not (ROOT / "tts-engine").exists():
        atomic_write(ROOT / "tts-engine", "espeak-ng\n")
    if not (ROOT / "tts-voice").exists():
        atomic_write(ROOT / "tts-voice", "es\n")
    if not (ROOT / "tts-speed").exists():
        atomic_write(ROOT / "tts-speed", "140\n")


def load_json(path: Path) -> dict:
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def profiles() -> list[dict]:
    return load_json(CATALOG)["profiles"]


def profile_by_id(profile_id: str) -> dict | None:
    return next((item for item in profiles() if item["id"] == profile_id), None)


def read_pref(name: str, default: str) -> str:
    try:
        return (ROOT / name).read_text(encoding="utf-8").strip() or default
    except OSError:
        return default


def current_profile() -> dict:
    engine = read_pref("tts-engine", "espeak-ng")
    voice = read_pref("tts-voice", "es")
    profile = next((item for item in profiles() if item["engine"] == engine and item["voice"] == voice), None)
    return profile or profile_by_id("espeak-retro")  # type: ignore[return-value]


def kokoro_ready() -> tuple[bool, str]:
    base = ROOT / "tts" / "kokoro"
    runtime = ROOT / "tts-venv" / "bin" / "python"
    if not (base / "kokoro-v1.0.int8.onnx").is_file() or not (base / "voices-v1.0.bin").is_file():
        return False, "modelo y voces no instalados (descarga explícita requerida)"
    if not runtime.is_file():
        return False, "runtime aislado no instalado"
    return True, "instalado"


def availability(profile: dict) -> tuple[bool, str]:
    status = profile["status"]
    if status == "blocked":
        return False, profile["reason"]
    if profile["engine"] == "espeak-ng":
        return shutil.which("espeak-ng") is not None, "espeak-ng no está instalado"
    if profile["engine"] == "kokoro-onnx":
        return kokoro_ready()
    return False, "motor no aprobado"


def report_profiles() -> list[dict]:
    result = []
    for profile in profiles():
        enabled, reason = availability(profile)
        result.append({**profile, "available": enabled, "availability_reason": reason if not enabled else "instalado"})
    return result


def safe_text(text: str) -> str:
    if "\0" in text or len(text) > MAX_TEXT:
        raise ValueError("texto TTS inválido")
    return text.strip()


class Broker:
    def __init__(self) -> None:
        self.requests: queue.Queue[tuple[str, dict]] = queue.Queue()
        self.stop = threading.Event()
        self.lock = threading.Lock()
        self.active: subprocess.Popen | None = None
        self.kokoro: subprocess.Popen | None = None
        self.generation = 0
        self.thread = threading.Thread(target=self.playback, daemon=True)

    def start(self) -> None:
        self.thread.start()
        if SOCKET.exists():
            SOCKET.unlink()
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(SOCKET))
        os.chmod(SOCKET, 0o600)
        server.listen(16)
        while not self.stop.is_set():
            try:
                connection, _ = server.accept()
            except OSError:
                break
            threading.Thread(target=self.handle, args=(connection,), daemon=True).start()

    def handle(self, connection: socket.socket) -> None:
        with connection:
            try:
                payload = connection.recv(MAX_TEXT + 1024).decode("utf-8")
                request = json.loads(payload)
                command = request.get("command")
                if command == "speak":
                    requested = request.get("profile")
                    profile = profile_by_id(requested) if requested else current_profile()
                    if not profile:
                        raise ValueError("perfil TTS desconocido")
                    self.requests.put((safe_text(request.get("text", "")), profile))
                    result = {"ok": True, "status": "queued"}
                elif command == "cancel":
                    self.cancel()
                    result = {"ok": True, "status": "cancelled"}
                elif command == "status":
                    result = {"ok": True, "queue": self.requests.qsize(), "profile": current_profile()["id"]}
                else:
                    result = {"ok": False, "error": "comando no permitido"}
            except Exception as exc:
                result = {"ok": False, "error": str(exc)}
            connection.sendall(json.dumps(result).encode("utf-8"))

    def cancel(self) -> None:
        with self.lock:
            self.generation += 1
            while True:
                try:
                    self.requests.get_nowait()
                except queue.Empty:
                    break
            for process in (self.active, self.kokoro):
                if process and process.poll() is None:
                    try:
                        os.killpg(process.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    threading.Thread(target=self._kill_if_needed, args=(process,), daemon=True).start()
            self.active = None
            self.kokoro = None
        atomic_write(ROOT / "tts-state", "cancelled\n")

    @staticmethod
    def _kill_if_needed(process: subprocess.Popen) -> None:
        """Bound cancellation: TERM first, then KILL for stuck engines."""
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def playback(self) -> None:
        while not self.stop.is_set():
            text, profile = self.requests.get()
            if not text:
                continue
            generation = self.generation
            atomic_write(ROOT / "tts-state", "speaking\n")
            try:
                self.speak(text, profile, generation)
            except Exception as exc:
                atomic_write(ROOT / "tts-error", str(exc) + "\n")
                # A non-default engine must never make speech unavailable.
                if profile["engine"] != "espeak-ng" and generation == self.generation:
                    try:
                        self.speak(text, profile_by_id("espeak-retro"), generation)  # type: ignore[arg-type]
                        atomic_write(ROOT / "tts-state", "fallback: espeak-retro\n")
                        continue
                    except Exception as fallback:
                        atomic_write(ROOT / "tts-error", f"{exc}; fallback: {fallback}\n")
            if generation == self.generation:
                atomic_write(ROOT / "tts-state", "idle\n")

    def invoke(self, command: list[str]) -> None:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
        with self.lock:
            self.active = process
        result = process.wait()
        with self.lock:
            if self.active is process:
                self.active = None
        if result:
            raise RuntimeError(f"reproductor terminó con código {result}")

    def speak(self, text: str, profile: dict, generation: int) -> None:
        available, reason = availability(profile)
        if not available:
            raise RuntimeError(reason)
        if profile["engine"] == "espeak-ng":
            # Preserve the established Spanish Retro synthesis parameters.
            speed = int(float(read_pref("tts-speed", "140")))
            # Keep the historical Stephen Hawking language hint, but never let
            # streamed AI text become arbitrary SSML.
            safe_ssml = html.escape(text).replace(
                "Stephen Hawking", '<lang xml:lang="en">Stephen Hawking</lang>')
            self.invoke(["espeak-ng", "-v", "es", "-m", "-s", str(speed), "-p", "40", safe_ssml])
            return
        wav = self.kokoro_wav(text, profile, generation)
        try:
            player = shutil.which("aplay")
            if not player:
                raise RuntimeError("aplay no está instalado")
            self.invoke([player, "-q", wav])
        finally:
            Path(wav).unlink(missing_ok=True)

    def kokoro_wav(self, text: str, profile: dict, generation: int) -> str:
        with self.lock:
            if not self.kokoro or self.kokoro.poll() is not None:
                worker = Path(__file__).with_name("talk2ai-tts-kokoro")
                runtime = ROOT / "tts-venv" / "bin" / "python"
                env = {**os.environ, "TALK2AI_TTS_DIR": str(ROOT)}
                self.kokoro = subprocess.Popen([str(runtime), str(worker)], stdin=subprocess.PIPE,
                                                stdout=subprocess.PIPE, text=True, bufsize=1,
                                                start_new_session=True, env=env)
            worker = self.kokoro
            assert worker.stdin and worker.stdout
            worker.stdin.write(json.dumps({"text": text, "voice": profile["voice"],
                                           "speed": profile["default_speed"]}) + "\n")
            worker.stdin.flush()
        line = worker.stdout.readline()
        if generation != self.generation:
            raise RuntimeError("síntesis cancelada")
        reply = json.loads(line or "{}")
        if not reply.get("ok"):
            raise RuntimeError(reply.get("error", "Kokoro no respondió"))
        return reply["path"]


def send(request: dict) -> dict:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(2)
            client.connect(str(SOCKET))
            client.sendall(json.dumps(request).encode("utf-8"))
            return json.loads(client.recv(8192).decode("utf-8"))
    except OSError as exc:
        raise RuntimeError("el servicio TTS no está activo") from exc


def verified_download(item: dict, destination: Path) -> None:
    expected = item["sha256"].lower()
    if destination.exists():
        digest = hashlib.sha256(destination.read_bytes()).hexdigest()
        if digest == expected:
            return
        raise RuntimeError(f"{destination.name} existe y no coincide con el SHA-256 esperado")
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".download-", dir=destination.parent)
    try:
        digest = hashlib.sha256()
        with os.fdopen(fd, "wb") as output, urllib.request.urlopen(item["url"], timeout=60) as response:
            while chunk := response.read(1024 * 1024):
                digest.update(chunk)
                output.write(chunk)
        if digest.hexdigest() != expected:
            raise RuntimeError(f"SHA-256 inválido para {item['name']}")
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)
    except Exception:
        Path(temporary).unlink(missing_ok=True)
        raise


def download_kokoro(confirm: bool) -> None:
    if not confirm:
        raise RuntimeError("la descarga es opcional: repita con --confirm")
    manifest = load_json(ARTIFACTS)["kokoro"]
    base = ROOT / "tts" / "kokoro"
    for key in ("model", "voices"):
        item = manifest[key]
        verified_download(item, base / item["name"])
    print("Kokoro-82M y el paquete de voces se han descargado y verificado. Instale antes el runtime aislado auditado.")


def choose(profile_id: str) -> None:
    profile = profile_by_id(profile_id)
    if not profile:
        raise RuntimeError("perfil desconocido")
    available, reason = availability(profile)
    if not available:
        raise RuntimeError(f"perfil no seleccionable: {reason}")
    atomic_write(ROOT / "tts-engine", profile["engine"] + "\n")
    atomic_write(ROOT / "tts-voice", profile["voice"] + "\n")
    atomic_write(ROOT / "tts-speed", str(profile["default_speed"]) + "\n")


def main() -> int:
    parser = argparse.ArgumentParser(description="talk2ai TTS closed-catalog broker")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("serve")
    listing = sub.add_parser("list")
    listing.add_argument("--json", action="store_true")
    select = sub.add_parser("select")
    select.add_argument("profile")
    sub.add_parser("speak")
    test = sub.add_parser("test")
    test.add_argument("profile")
    download = sub.add_parser("download")
    download.add_argument("profile", choices=["kokoro-ef-dora", "kokoro-em-alex", "kokoro-em-santa"])
    download.add_argument("--confirm", action="store_true")
    sub.add_parser("cancel")
    sub.add_parser("status")
    args = parser.parse_args()
    bootstrap()
    try:
        if args.command == "serve":
            Broker().start()
        elif args.command == "list":
            data = report_profiles()
            if args.json:
                print(json.dumps(data, ensure_ascii=False))
            else:
                for item in data:
                    print(f"{item['id']}\t{'available' if item['available'] else 'unavailable'}\t{item['availability_reason']}")
        elif args.command == "select":
            choose(args.profile)
        elif args.command == "download":
            download_kokoro(args.confirm)
        elif args.command == "speak":
            print(json.dumps(send({"command": "speak", "text": sys.stdin.read()}), ensure_ascii=False))
        elif args.command == "test":
            profile = profile_by_id(args.profile)
            if not profile:
                raise RuntimeError("perfil desconocido")
            available, reason = availability(profile)
            if not available:
                raise RuntimeError(f"perfil no disponible: {reason}")
            # A test never changes the persistent selection.
            print(json.dumps(send({"command": "speak", "text": TEST_PHRASE,
                                   "profile": profile["id"]}), ensure_ascii=False))
        elif args.command in {"cancel", "status"}:
            print(json.dumps(send({"command": args.command}), ensure_ascii=False))
    except Exception as exc:
        print(f"talk2ai-tts: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
