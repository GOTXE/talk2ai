#!/usr/bin/env python3
"""Persistent, stdin/stdout-only Kokoro worker owned by talk2ai-tts."""
import json
import os
import sys
import tempfile
import wave
from pathlib import Path


def write_wav(samples, path: Path, sample_rate: int) -> None:
    # Kokoro returns float samples in [-1, 1].  Use the stdlib to avoid an
    # extra audio-writing dependency in the system interpreter.
    values = bytearray()
    for sample in samples:
        sample = max(-1.0, min(1.0, float(sample)))
        values.extend(int(sample * 32767).to_bytes(2, "little", signed=True))
    with wave.open(str(path), "wb") as output:
        output.setnchannels(1)
        output.setsampwidth(2)
        output.setframerate(sample_rate)
        output.writeframes(values)


def main() -> int:
    from kokoro_onnx import Kokoro  # Installed only in the dedicated venv.

    root = Path(os.environ["TALK2AI_TTS_DIR"])
    model = root / "tts" / "kokoro" / "kokoro-v1.0.int8.onnx"
    voices = root / "tts" / "kokoro" / "voices-v1.0.bin"
    kokoro = Kokoro(str(model), str(voices))
    for line in sys.stdin:
        try:
            request = json.loads(line)
            text = request["text"]
            voice = request["voice"]
            speed = float(request["speed"])
            samples, sample_rate = kokoro.create(text, voice=voice, speed=speed, lang="e")
            fd, name = tempfile.mkstemp(prefix="kokoro-", suffix=".wav", dir=root / "tts" / "tmp")
            os.close(fd)
            write_wav(samples, Path(name), sample_rate)
            print(json.dumps({"ok": True, "path": name}), flush=True)
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)}), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
