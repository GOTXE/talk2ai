#!/usr/bin/env python3
"""Tray icon para talk2ai."""

import os
import sys
import subprocess
import threading
from datetime import datetime
from pathlib import Path

from PyQt6.QtWidgets import (QApplication, QSystemTrayIcon, QMenu,
                              QWidget, QVBoxLayout, QHBoxLayout,
                              QTextEdit, QTextBrowser, QPushButton)
from PyQt6.QtGui import (QIcon, QPixmap, QPainter, QColor, QBrush,
                         QFont, QAction, QPainterPath, QTransform, QTextCursor,
                         QRadialGradient, QLinearGradient)
from PyQt6.QtCore import QTimer, Qt, QRectF, pyqtSignal, QObject, QFileSystemWatcher, QByteArray
from PyQt6.QtSvg import QSvgRenderer

HANDY_DB           = Path.home() / ".local/share/com.pais.handy/history.db"
TALK2AI_DIR        = Path.home() / ".talk2ai"
MODE_FILE          = TALK2AI_DIR / "mode"
DRIVER_FILE        = TALK2AI_DIR / "driver"
STATE_FILE         = TALK2AI_DIR / "ai-state"
DEBUG_ENABLED_FILE = TALK2AI_DIR / "debug"
DEBUG_LOG_FILE     = TALK2AI_DIR / "debug.log"
MODEL_FILE         = TALK2AI_DIR / "model"
SERVICE            = "talk2ai.service"

# Curva de latido: doble pulso rápido + pausa (escala relativa)
HEARTBEAT_FRAMES = [1.0, 1.18, 1.0, 1.10, 1.0, 1.0, 1.0, 1.0]

# Logo oficial Gemini 2025 (estrella 4 puntas con gradiente azul→violeta)
