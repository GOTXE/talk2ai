#!/bin/bash
# Driver: Gemini (Antigravity AGY CLI)
# Contrato: recibe $1=prompt, lee TALK2AI_MODEL / TALK2AI_VOICE_PROMPT / TALK2AI_CONTEXT_FILE

export PATH="$HOME/.local/bin:$HOME/.gemini/antigravity-cli/bin:$PATH"

PROMPT="$1"
if [ -z "$PROMPT" ]; then
    echo "Uso: gemini <prompt>" >&2
    exit 1
fi

MODEL="${TALK2AI_MODEL:-gemini-3.8-flash-low}"
case "$MODEL" in
    gemini-2.5*|gemini-2.0*|gemini-1.5*)
        MODEL="gemini-3.8-flash-low"
        ;;
    gemini-3.8-flash)
        MODEL="gemini-3.8-flash-low"
        ;;
esac

RUNTIME_DIR=$(mktemp -d)
trap 'rm -rf "$RUNTIME_DIR"' EXIT

{
    [ -n "$TALK2AI_VOICE_PROMPT" ] && [ -f "$TALK2AI_VOICE_PROMPT" ] && cat "$TALK2AI_VOICE_PROMPT"
    echo ""
    [ -n "$TALK2AI_CONTEXT_FILE" ] && [ -f "$TALK2AI_CONTEXT_FILE" ] && cat "$TALK2AI_CONTEXT_FILE"
} > "$RUNTIME_DIR/GEMINI.md"

if command -v agy &>/dev/null; then
    (cd "$RUNTIME_DIR" && agy -p "$PROMPT" --model "$MODEL" --disable-slash-commands --dangerously-skip-permissions)
else
    (cd "$RUNTIME_DIR" && gemini --model "$MODEL" --skip-trust -p "$PROMPT")
fi
