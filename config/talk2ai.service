[Unit]
Description=talk2ai — voice assistant daemon
After=graphical-session.target talk2ai-tts.service
Wants=graphical-session.target
Requires=talk2ai-tts.service

[Service]
Type=simple
Environment=TALK2AI_DIR=@TALK2AI_DIR@
Environment=TALK2AI_DATA_DIR=@TALK2AI_DATA_DIR@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/talk2ai-daemon
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
