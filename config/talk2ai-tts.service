[Unit]
Description=talk2ai TTS broker
After=graphical-session.target
PartOf=talk2ai.service

[Service]
Type=simple
Environment=TALK2AI_DIR=@TALK2AI_DIR@
Environment=TALK2AI_DATA_DIR=@TALK2AI_DATA_DIR@
ExecStart=%h/.local/bin/talk2ai-tts serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
